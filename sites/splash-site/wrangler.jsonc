{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "splashbrowser",
  "compatibility_date": "2026-11-10",
  "main": "worker/index.js",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/*"] },
  "workers_dev": true,
  "routes": [
    { "pattern": "splashbrowser.de", "custom_domain": true },
    { "pattern": "www.splashbrowser.de", "custom_domain": true }
  ]
}
